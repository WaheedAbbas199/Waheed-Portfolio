# ---- App ----
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=sqlite:///./data/portfolio.db
# Production: postgresql+psycopg2://user:pass@host:5432/portfolio

# ---- Security ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_HOURS=8
# Origins allowed to call the PUBLIC api from the browser (your deployed frontend URL). Admin is same-origin only.
PUBLIC_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# ---- Gemini chatbot ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash    # check Google's current model list
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
CHAT_RATE_PER_MINUTE=12
CHAT_MAX_MESSAGE_CHARS=800

# ---- Email (contact notifications) ----
EMAIL_PROVIDER=disabled          # disabled | resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Portfolio <onboarding@resend.dev>
NOTIFY_EMAIL=waheedabbass2211@gmail.com
CONTACT_RATE_PER_HOUR=5
